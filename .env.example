# Contact Form SMTP Configuration
SMTP_USER=your_gmail_address
SMTP_PASSWORD=your_gmail_app_password
CONTACT_TO_EMAIL=where_portfolio_messages_should_arrive

# Public site URL used for canonical and social metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=your_google_analytics_id

# Telegram Bot Notifications (token is AES-256-GCM encrypted)
TELEGRAM_BOT_TOKEN_ENCRYPTED=your_encrypted_bot_token
TELEGRAM_ENCRYPTION_KEY=your_encryption_key
TELEGRAM_CHAT_ID=your_telegram_user_id
